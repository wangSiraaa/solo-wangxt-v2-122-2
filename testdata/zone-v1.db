$ORIGIN lab.test.
$TTL 3600
@   IN SOA ns1.lab.test. admin.lab.test. (
        1          ; serial (overwritten by publisher)
        7200       ; refresh
        3600       ; retry
        1209600    ; expire
        300 )      ; minimum / negative cache TTL
@       IN NS  ns1.lab.test.
@       IN NS  ns2.lab.test.
ns1     IN A   127.0.0.10
ns2     IN A   127.0.0.11
@       IN A   127.0.0.5
www     IN A   127.0.0.20
www     IN A   127.0.0.21
www     IN TXT "multi-record same name v1"
alias   IN CNAME www.lab.test.
mx1     IN MX  10 mail.lab.test.
mail    IN A   127.0.0.25
_sip._tcp IN SRV 10 60 5060 sip.lab.test.
sip     IN A   127.0.0.26
host1   IN AAAA 2001:db8::10
cafile  IN CAA 0 issue "ca.lab.test"
*.wild  IN A   127.0.0.99
